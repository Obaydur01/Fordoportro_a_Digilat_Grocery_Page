# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_USERNAME=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/fordoportro_db?retryWrites=true&w=majority

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_admin_password
SUPER_ADMIN_SECRET=your_super_secret_key

# Contact & Social
WHATSAPP_BUSINESS_NUMBER=01XXXXXXXXX
FACEBOOK_PAGE_URL=https://www.facebook.com/your_page

# Firebase Configuration
FIREBASE_API_KEY=your_firebase_api_key
